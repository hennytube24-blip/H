rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Action Plans
    match /action_plans/{planId} {
      allow read, write: if true;
    }

    // Chat Messages
    match /chat_messages/{messageId} {
      allow read, write: if true;
    }

    // Archives
    match /archives/{archiveId} {
      allow read, write: if true;
    }

    // Meeting Minutes
    match /meeting_minutes/{minuteId} {
      allow read, write: if true;
    }

    // KPIs
    match /kpis/{kpiId} {
      allow read, write: if true;
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // Custom application tiles
    match /app_tiles/{tileId} {
      allow read, write: if true;
    }
  }
}
